# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase — shared with NeuralQuant
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=

# Alpaca Paper Trading
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_PAPER_TRADE=true

# Data APIs
FMP_API_KEY=...
FINNHUB_API_KEY=...

# Pipeline Settings
DRY_RUN=false
TRADE_ENABLED=false
MAX_POSITION_PCT=0.10
MAX_SECTOR_PCT=0.30
MAX_POSITIONS_PER_SECTOR=1
MAX_DRAWDOWN_PCT=0.10
DAILY_LOSS_LIMIT=100.0
DAILY_TRADE_CAP=5
MAX_BET_DEFAULT=5000.0
MAX_POSITIONS_DEFAULT=10

# Signal Engine
SIGNAL_TOP_N=5
TRADE_DAEMON_TOP_N=5
TRADE_DAEMON_MAX_SIGNALS_PER_DAY=20
TRADE_DAEMON_SCAN_INTERVAL_MINUTES=15
TRADE_DAEMON_BANKROLL=10000.0

# Multi-Asset Toggles
IN_MARKET_ENABLED=false
CRYPTO_ENABLED=false
POLYMARKET_ENABLED=false

# Crypto
CRYPTO_TOP_N=3

# Polymarket
POLYMARKET_MAX_PER_MARKET=500
POLYMARKET_SCAN_INTERVAL_MINUTES=30

# Regime Detection
REGIME_N_STATES=4

# Online Learning (disabled — equal weights beat learned by $22.7K in 19yr replay)
ONLINE_LEARNING_ENABLED=false

# Weekend Retraining
RETRAIN_ENABLED=true
RETRAIN_MAX_TRIALS=500

# Trend Filter (block entries when SPX below 200MA)
TREND_FILTER_ENABLED=true

# ATR-based Volatility-Adjusted TP/SL (dynamic exits scaled by Average True Range)
ATR_ENABLED=true
ATR_PERIOD=14
ATR_TP_MULTIPLIER=2.0
ATR_SL_MULTIPLIER=2.0

# X (Twitter) API (deprecated — multi-source free pipeline replaces this)
# X_BEARER_TOKEN=AAAA...
# X_API_KEY=...
# X_API_SECRET=...

# Multi-Source Sentiment Scanner (completely free: Reddit RSS + Finnhub + RSS)
SENTIMENT_ENABLED=false
SENTIMENT_SCAN_INTERVAL_MINUTES=30
SENTIMENT_SOURCES=reddit,finnhub,rss
SENTIMENT_MAX_ITEMS=80

# Put/Call Ratio Options Sentiment (live-only — uses yfinance option_chain, no historical data)
OPTION_SENTIMENT_ENABLED=false
OPTION_SENTIMENT_MAX_TICKERS=20

# Dashboard
DASHBOARD_PORT=8420
